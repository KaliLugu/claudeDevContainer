# Token obtenu via `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Identité git des commits faits par Claude dans le conteneur (optionnel)
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Repos git d'agents et de contextes de projets (optionnel).
# Liste nom=url séparés par des virgules, sans espaces ni guillemets
# (docker --env-file ne les retire pas). Ordre = priorité.
# CLAUDE_AGENTS_REPOS=perso=git@github.com:<toi>/claude-agents.git,equipe=git@github.com:<equipe>/agents.git
# Repos où Claude écrit et pousse librement (noms, virgules). Les autres sont en lecture seule.
# CLAUDE_AGENTS_PUSH=perso
