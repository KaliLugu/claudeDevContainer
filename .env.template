# Token obtenu via `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=

# Identité git des commits faits par Claude dans le conteneur (optionnel)
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# Repos d'agents et de contextes de projets (optionnel).
# Liste nom=source séparés par des virgules, sans espaces ni guillemets
# (docker --env-file ne les retire pas). Ordre = priorité.
# Source = URL git (cloné dans le conteneur) ou chemin local (relatif à ce
# repo ou absolu, monté tel quel dans le conteneur).
# CLAUDE_AGENTS_REPOS=perso=../claude-agents,equipe=git@github.com:<equipe>/agents.git
# Repos où Claude écrit et pousse librement (noms, virgules). Les autres sont en lecture seule.
# CLAUDE_AGENTS_PUSH=perso
# Délai entre deux vérifications de mises à jour des repos d'agents (heures, défaut 24)
# CLAUDE_AGENTS_CHECK_HOURS=24
