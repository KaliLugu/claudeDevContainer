{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /etc/claude-code/hooks/push-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/agents-repos/session-context.md\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
