#!/usr/bin/env bash
# Lance Claude Code dans le conteneur, avec le dossier courant comme projet.
# Usage : claude-docker [--rebuild] [--no-sudo] [arguments passés à claude...]
#         claude-docker --clean
set -euo pipefail

REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
IMAGE="${CLAUDE_DOCKER_IMAGE:-claude-code}"
CONFIG_VOLUME="${CLAUDE_DOCKER_CONFIG_VOLUME:-claude-config}"
TOOLS_VOLUME="${CLAUDE_DOCKER_TOOLS_VOLUME:-claude-tools}"
PROJECT_DIR="$(pwd)"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --rebuild) REBUILD=1 ;;
        --no-sudo) NO_SUDO=1 ;;
        --clean) CLEAN=1 ;;
        *) break ;;
    esac
    shift
done

# --clean : supprime les images dérivées des paquets de projet, qui
# s'accumulent quand les listes changent. Elles sont reconstruites à la demande.
if [[ -n "${CLEAN:-}" ]]; then
    removed=0
    for img in $(docker images --format '{{.Repository}}:{{.Tag}}' "${IMAGE%%:*}-pkg"); do
        if docker image rm "$img" >/dev/null 2>&1; then
            removed=$((removed + 1))
        else
            echo "claude-docker: $img est utilisée par un conteneur, conservée" >&2
        fi
    done
    echo "claude-docker: $removed image(s) de paquets supprimée(s)"
    exit 0
fi

# Construit l'image si absente, si le dockerfile a changé ou si --rebuild,
# avec l'UID/GID de l'hôte pour que les fichiers créés t'appartiennent.
DOCKERFILE_SUM="$(cksum < "$REPO_DIR/dockerfile" | cut -d' ' -f1)"
built_sum="$(docker image inspect -f '{{index .Config.Labels "claude-docker.dockerfile"}}' "$IMAGE" 2>/dev/null || true)"
if [[ -n "${REBUILD:-}" || "$built_sum" != "$DOCKERFILE_SUM" ]]; then
    docker build \
        ${REBUILD:+--no-cache --pull} \
        --label "claude-docker.dockerfile=$DOCKERFILE_SUM" \
        --build-arg UID="$(id -u)" \
        --build-arg GID="$(id -g)" \
        -t "$IMAGE" \
        -f "$REPO_DIR/dockerfile" \
        "$REPO_DIR"
fi

# Paquets apt du projet (.claude-docker/packages, un par ligne) : installés
# dans une image dérivée, en cache tant que la liste ne change pas.
RUN_IMAGE="$IMAGE"
PKG_FILE="$PROJECT_DIR/.claude-docker/packages"
if [[ -f "$PKG_FILE" ]]; then
    pkgs="$(sed 's/#.*//' "$PKG_FILE" | tr -s ' \t\r\n' ' ' | sed 's/^ //; s/ $//')"
    for p in $pkgs; do
        if [[ ! "$p" =~ ^[a-z0-9][a-z0-9+.:=~-]*$ ]]; then
            echo "claude-docker: nom de paquet invalide dans $PKG_FILE : $p" >&2
            exit 1
        fi
    done
    if [[ -n "$pkgs" ]]; then
        base_id="$(docker image inspect -f '{{.Id}}' "$IMAGE")"
        RUN_IMAGE="${IMAGE%%:*}-pkg:$(printf '%s %s' "$base_id" "$pkgs" | cksum | cut -d' ' -f1)"
        if ! docker image inspect "$RUN_IMAGE" >/dev/null 2>&1; then
            echo "claude-docker: installation des paquets du projet : $pkgs" >&2
            docker build -t "$RUN_IMAGE" - <<DOCKERFILE
FROM $IMAGE
USER root
RUN apt-get update && apt-get install -y --no-install-recommends $pkgs && rm -rf /var/lib/apt/lists/*
USER dev
DOCKERFILE
        fi
    fi
fi

args=(
    --rm
    --name "claude-$(basename "$PROJECT_DIR" | tr -c 'a-zA-Z0-9_.-' '-')-$$"
    -v "$CONFIG_VOLUME:/home/dev/.claude"
    -v "$TOOLS_VOLUME:/home/dev/.local/share/mise"
    # Règles globales versionnées dans ce repo (lecture seule)
    -v "$REPO_DIR/config/CLAUDE.md:/home/dev/.claude/CLAUDE.md:ro"
    # Réglages imposés et hooks (contrôle des push), non modifiables par Claude
    -v "$REPO_DIR/config/managed:/etc/claude-code:ro"
    # Même chemin que sur l'hôte : l'historique Claude reste distinct par projet
    -v "$PROJECT_DIR:$PROJECT_DIR"
    -w "$PROJECT_DIR"
    --cap-drop ALL
    --pids-limit 4096
)

if [[ -n "${NO_SUDO:-}" ]]; then
    args+=(--security-opt no-new-privileges -e CLAUDE_DOCKER_NO_SUDO=1)
else
    # Seulement ce qu'il faut à sudo et apt
    for cap in CHOWN DAC_OVERRIDE FOWNER FSETID SETUID SETGID KILL AUDIT_WRITE NET_BIND_SERVICE; do
        args+=(--cap-add "$cap")
    done
fi

# Clé SSH dédiée à Claude (créée par setup-ssh-key.sh), si présente
if [[ -f "$REPO_DIR/ssh/id_ed25519" ]]; then
    args+=(-v "$REPO_DIR/ssh:/home/dev/.ssh:ro")
fi

# Pseudo-terminal seulement si on est dans un terminal
args+=(-i)
if [[ -t 0 && -t 1 ]]; then
    args+=(-t)
fi

if [[ -f "$REPO_DIR/.env" ]]; then
    args+=(--env-file "$REPO_DIR/.env")

    # Repos d'agents donnés par un chemin local (relatif à ce repo ou absolu) :
    # monte chaque dossier au même chemin et passe la liste en chemins absolus.
    agents_repos="$(grep -E '^CLAUDE_AGENTS_REPOS=' "$REPO_DIR/.env" | tail -n 1 | cut -d= -f2- || true)"
    if [[ -n "$agents_repos" ]]; then
        resolved=()
        IFS=, read -ra entries <<< "$agents_repos"
        for entry in "${entries[@]}"; do
            name="${entry%%=*}"
            src="${entry#*=}"
            case "$src" in
                /*|./*|../*|~/*)
                    src="${src/#\~/$HOME}"
                    [[ "$src" == /* ]] || src="$REPO_DIR/$src"
                    if [[ ! -d "$src" ]]; then
                        echo "claude-docker: repo d'agents '$name' introuvable : $src (ignoré)" >&2
                        continue
                    fi
                    src="$(cd "$src" && pwd)"
                    # Déjà visible si c'est le projet lui-même ou un de ses sous-dossiers
                    if [[ "$src" != "$PROJECT_DIR" && "$src" != "$PROJECT_DIR"/* ]]; then
                        args+=(-v "$src:$src")
                    fi
                    ;;
            esac
            resolved+=("$name=$src")
        done
        args+=(-e "CLAUDE_AGENTS_REPOS=$(IFS=,; echo "${resolved[*]}")")
    fi
fi

exec docker run "${args[@]}" "$RUN_IMAGE" bash /etc/claude-code/start.sh "$@"
